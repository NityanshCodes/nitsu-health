# Database Configuration
DATABASE_URL=sqlite:///./nitsu_health.db
# For PostgreSQL: postgresql://user:password@localhost:5432/nitsu_health

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment
ENVIRONMENT=development
DEBUG=false

# AI Provider Configuration
AI_PROVIDER=development
# For OpenAI: AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
