# ---------------------------------------------------------------------------
# NITSU Health — backend environment configuration (development defaults)
# Copy to `backend/.env` (and/or the repo-root `.env`) and adjust.
# Values are read by backend/app/core/config.py.
# ---------------------------------------------------------------------------

# --- Core ---
ENVIRONMENT=development            # development | production
DEBUG=false
# SQLite for local dev:
DATABASE_URL=sqlite:///./nitsu_health.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nitsu_health

# --- Auth (JWT) ---
# Generate a strong value for production:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# --- AI provider ---
# AI_PROVIDER=development runs keyless (deterministic dev responses).
# AI_PROVIDER=openai requires OPENAI_API_KEY.
AI_PROVIDER=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Wearables (Fitbit OAuth2 — backend-only secrets) ---
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:8000/wearables/fitbit/callback

# --- Payments (Razorpay — backend-only secrets) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PREMIUM_PRICE=499
PAYMENT_CURRENCY=INR
FRONTEND_BASE_URL=http://localhost:5173

# --- Security ---
# Key used to encrypt wearable access/refresh tokens at rest.
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(32))"
TOKEN_ENCRYPTION_KEY=

# --- Rate limiting (per window, per client) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# --- Feature entitlements (FREE tier limits) ---
FREE_REPORT_LIMIT=2
FREE_INSIGHT_LIMIT=3
FREE_AI_QUESTIONS_PER_DAY=10
